<%- include('partials/header') %>

<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-12">

  <!-- Header -->
  <div class="border-b border-slate-800 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-xs font-semibold mb-2">
      <i data-lucide="layers" class="w-3.5 h-3.5"></i>
      <span>Requirements #4, #5 & #6</span>
    </div>
    <h1 class="text-3xl font-extrabold text-white">AWS Cloud Architecture & Defense Guide</h1>
    <p class="text-slate-400 text-sm mt-1">
      Complete architectural mapping, network topology, and individual knowledge defense notes for AASTMT evaluation.
    </p>
  </div>

  <!-- Interactive SVG Architecture Diagram -->
  <div class="rounded-3xl bg-slate-900 border border-slate-800 p-8 shadow-2xl space-y-6">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <h2 class="text-xl font-bold text-white flex items-center gap-2">
          <i data-lucide="workflow" class="w-5 h-5 text-amber-400"></i>
          <span>Multi-Tier AWS Topology Diagram</span>
        </h2>
        <p class="text-xs text-slate-400 mt-0.5">Illustrating the exact flow of user traffic, security perimeters, and service connections</p>
      </div>
      <span class="text-xs font-mono px-3 py-1 rounded-lg bg-slate-800 text-slate-300 border border-slate-700">
        Region: <%= awsRegion %>
      </span>
    </div>

    <!-- Diagram Canvas -->
    <div class="w-full overflow-x-auto bg-slate-950 rounded-2xl p-6 border border-slate-800">
      <svg class="w-full min-w-[800px] h-auto" viewBox="0 0 950 520" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <linearGradient id="cloudGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#1e293b" stop-opacity="0.6"/>
            <stop offset="100%" stop-color="#0f172a" stop-opacity="0.9"/>
          </linearGradient>
          <linearGradient id="vpcGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#581c87" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#3b0764" stop-opacity="0.05"/>
          </linearGradient>
          <linearGradient id="publicSubnet" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#0284c7" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#0369a1" stop-opacity="0.05"/>
          </linearGradient>
          <linearGradient id="privateSubnet" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#059669" stop-opacity="0.15"/>
            <stop offset="100%" stop-color="#047857" stop-opacity="0.05"/>
          </linearGradient>
          <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur stdDeviation="4" result="blur"/>
            <feComposite in="SourceGraphic" in2="blur" operator="over"/>
          </filter>
        </defs>

        <!-- Outer AWS Cloud Box -->
        <rect x="200" y="20" width="730" height="480" rx="20" fill="url(#cloudGrad)" stroke="#334155" stroke-width="2" stroke-dasharray="6 4"/>
        <text x="220" y="50" fill="#94a3b8" font-size="14" font-weight="700" font-family="sans-serif">AWS Cloud (<%= awsRegion %>)</text>

        <!-- S3 Bucket (Outside VPC, inside AWS Cloud) -->
        <rect x="740" y="60" width="170" height="150" rx="14" fill="#0c4a6e" fill-opacity="0.4" stroke="#0284c7" stroke-width="2"/>
        <text x="760" y="90" fill="#38bdf8" font-size="13" font-weight="bold" font-family="sans-serif">Amazon S3</text>
        <text x="760" y="110" fill="#94a3b8" font-size="10" font-family="monospace"><%= s3Info.bucket %></text>
        <text x="760" y="135" fill="#cbd5e1" font-size="10" font-family="sans-serif">&bull; Vehicle Photos</text>
        <text x="760" y="155" fill="#cbd5e1" font-size="10" font-family="sans-serif">&bull; Static Assets</text>
        <text x="760" y="175" fill="#38bdf8" font-size="10" font-family="sans-serif">&bull; IAM Instance Profile</text>

        <!-- VPC Boundary -->
        <rect x="220" y="70" width="490" height="410" rx="16" fill="url(#vpcGrad)" stroke="#9333ea" stroke-width="2"/>
        <text x="240" y="100" fill="#c084fc" font-size="14" font-weight="bold" font-family="sans-serif">Custom VPC (10.0.0.0/16)</text>

        <!-- Internet Gateway -->
        <rect x="235" y="130" width="60" height="60" rx="10" fill="#312e81" stroke="#6366f1" stroke-width="2"/>
        <text x="245" y="158" fill="#a5b4fc" font-size="11" font-weight="bold" font-family="sans-serif">IGW</text>
        <text x="240" y="175" fill="#cbd5e1" font-size="9" font-family="sans-serif">0.0.0.0/0</text>

        <!-- Public Subnet -->
        <rect x="310" y="120" width="380" height="160" rx="12" fill="url(#publicSubnet)" stroke="#0284c7" stroke-width="1.5"/>
        <text x="325" y="142" fill="#38bdf8" font-size="12" font-weight="bold" font-family="sans-serif">Public Subnet (10.0.1.0/24)</text>

        <!-- EC2 Instance -->
        <rect x="340" y="160" width="320" height="100" rx="10" fill="#1e293b" stroke="#f59e0b" stroke-width="2"/>
        <text x="360" y="188" fill="#fbbf24" font-size="13" font-weight="bold" font-family="sans-serif">Amazon EC2 (Node.js Web Server)</text>
        <text x="360" y="210" fill="#cbd5e1" font-size="11" font-family="sans-serif">Port 80 (HTTP) &bull; Security Group: sg-web</text>
        <text x="360" y="230" fill="#94a3b8" font-size="10" font-family="monospace">Instance: <%= ec2Info ? ec2Info.instanceId : 't2.micro / t3.micro' %></text>
        <text x="360" y="248" fill="#a3e635" font-size="10" font-family="sans-serif">&bull; Hosts 3 Pages & API Engine</text>

        <!-- Private Subnet -->
        <rect x="310" y="300" width="380" height="160" rx="12" fill="url(#privateSubnet)" stroke="#059669" stroke-width="1.5"/>
        <text x="325" y="325" fill="#34d399" font-size="12" font-weight="bold" font-family="sans-serif">Private Subnet (10.0.11.0/24) - No Public IP</text>

        <!-- RDS DB Instance -->
        <rect x="340" y="340" width="320" height="100" rx="10" fill="#1e293b" stroke="#10b981" stroke-width="2"/>
        <text x="360" y="368" fill="#34d399" font-size="13" font-weight="bold" font-family="sans-serif">Amazon RDS (<%= dbStatus.engine.toUpperCase() %>)</text>
        <text x="360" y="390" fill="#cbd5e1" font-size="11" font-family="sans-serif">Port 3306/5432 &bull; Security Group: sg-rds</text>
        <text x="360" y="410" fill="#94a3b8" font-size="10" font-family="sans-serif">Inbound Rule: EC2 Security Group ONLY</text>
        <text x="360" y="428" fill="#6ee7b7" font-size="10" font-family="monospace">Table: cars (Vehicle Metadata)</text>

        <!-- User / Client (Outside Cloud) -->
        <rect x="20" y="190" width="130" height="90" rx="12" fill="#1e293b" stroke="#f43f5e" stroke-width="2"/>
        <text x="40" y="225" fill="#fda4af" font-size="13" font-weight="bold" font-family="sans-serif">User / Browser</text>
        <text x="45" y="245" fill="#94a3b8" font-size="10" font-family="sans-serif">HTTP Port 80</text>
        <text x="35" y="265" fill="#cbd5e1" font-size="9" font-family="sans-serif">Public Internet</text>

        <!-- CONNECTOR LINES -->
        <!-- User to IGW -->
        <line x1="150" y1="235" x2="235" y2="160" stroke="#f43f5e" stroke-width="2.5" stroke-dasharray="4"/>
        <!-- IGW to EC2 -->
        <line x1="295" y1="160" x2="340" y2="190" stroke="#f59e0b" stroke-width="2.5"/>
        <!-- EC2 to RDS (Database Query) -->
        <line x1="500" y1="260" x2="500" y2="340" stroke="#10b981" stroke-width="3"/>
        <text x="510" y="305" fill="#34d399" font-size="10" font-weight="bold" font-family="monospace">SQL Queries (TCP 3306)</text>
        <!-- EC2 to S3 (Upload / Fetch) -->
        <line x1="660" y1="190" x2="740" y2="140" stroke="#38bdf8" stroke-width="2.5"/>
        <text x="670" y="160" fill="#38bdf8" font-size="10" font-weight="bold" font-family="sans-serif">PutObject / IAM</text>
        <!-- User direct S3 Image delivery -->
        <path d="M 150 220 Q 400 30 740 90" fill="transparent" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="3 3"/>
        <text x="420" y="45" fill="#7dd3fc" font-size="9" font-family="sans-serif">Direct S3 Image Delivery via HTTPS</text>
      </svg>
    </div>
  </div>

  <!-- Section 6: Individual Knowledge Defense Prep -->
  <div class="space-y-6">
    <div class="border-b border-slate-800 pb-4">
      <h2 class="text-2xl font-bold text-white flex items-center gap-2">
        <i data-lucide="graduation-cap" class="w-6 h-6 text-amber-400"></i>
        <span>Section 6 Defense Guide — Expected Discussion Questions</span>
      </h2>
      <p class="text-slate-400 text-sm mt-1">
        Per project requirements, each of the 3 students must be prepared to answer individual questions on all services:
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

      <!-- Question 1: Amazon VPC -->
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3">
        <div class="flex items-center gap-2 text-purple-400 font-bold text-sm">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
          <span>Question 1: Why is a Custom VPC needed and why separate subnets?</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong class="text-white">Answer:</strong> A custom VPC isolates our cloud resources inside a dedicated virtual network (<code class="text-purple-300">10.0.0.0/16</code>). We separate the network into a <strong>Public Subnet</strong> (with an Internet Gateway route so users can access EC2 on port 80) and a <strong>Private Subnet</strong> (with NO Internet Gateway route for Amazon RDS). This defense-in-depth architecture prevents anyone on the public internet from attacking the database directly.
        </p>
      </div>

      <!-- Question 2: Security Groups -->
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3">
        <div class="flex items-center gap-2 text-amber-400 font-bold text-sm">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
          <span>Question 2: How are Security Groups configured between EC2 and RDS?</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong class="text-white">Answer:</strong> The EC2 Security Group (<code class="text-amber-300">sg-web</code>) allows inbound HTTP traffic on port 80 from <code class="text-slate-400">0.0.0.0/0</code>. The RDS Security Group (<code class="text-emerald-300">sg-rds</code>) strictly allows MySQL/Postgres inbound traffic (port 3306/5432) <em>ONLY</em> from the source ID of <code class="text-amber-300">sg-web</code>, rather than an IP address. This guarantees only our authorized web server can query the database.
        </p>
      </div>

      <!-- Question 3: Amazon S3 vs EC2 EBS -->
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3">
        <div class="flex items-center gap-2 text-sky-400 font-bold text-sm">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
          <span>Question 3: Why store uploaded images in Amazon S3 instead of EC2?</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong class="text-white">Answer:</strong> Storing user uploads on the EC2 instance's EBS volume makes the server stateful; if the instance crashes or autoscales, uploaded images are lost. <strong>Amazon S3</strong> provides 99.999999999% (11 9s) of durability, scales infinitely, offloads image bandwidth away from the web server, and allows stateless EC2 scaling.
        </p>
      </div>

      <!-- Question 4: Amazon RDS vs Self-Hosted DB -->
      <div class="p-6 rounded-2xl bg-slate-900 border border-slate-800 space-y-3">
        <div class="flex items-center gap-2 text-emerald-400 font-bold text-sm">
          <i data-lucide="help-circle" class="w-4 h-4"></i>
          <span>Question 4: Why use managed Amazon RDS instead of installing MySQL on EC2?</span>
        </div>
        <p class="text-xs text-slate-300 leading-relaxed">
          <strong class="text-white">Answer:</strong> Amazon RDS is a fully managed service that automates database provisioning, OS patching, automated daily backups, multi-AZ replication, and point-in-time recovery. Running MySQL directly on EC2 requires manual administrative overhead, backup scripts, and risks single points of failure.
        </p>
      </div>

    </div>
  </div>

</div>

<%- include('partials/footer') %>

