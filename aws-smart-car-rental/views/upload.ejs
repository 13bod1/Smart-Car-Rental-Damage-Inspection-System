<%- include('partials/header') %>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">

  <!-- Header -->
  <div class="border-b border-slate-800 pb-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-sky-500/10 border border-sky-500/20 text-sky-400 text-xs font-semibold mb-2">
      <i data-lucide="upload-cloud" class="w-3.5 h-3.5"></i>
      <span>Amazon S3 & Amazon RDS Integration</span>
    </div>
    <h1 class="text-3xl font-extrabold text-white">Add New Vehicle to Fleet</h1>
    <p class="text-slate-400 text-sm mt-1">
      This form fulfills <strong class="text-white">Requirement #3 (Form / Upload Page)</strong>. Uploaded photos are stored as objects in <strong class="text-sky-400">Amazon S3 (<%= s3Bucket %>)</strong>, and record metadata is committed to <strong class="text-emerald-400">Amazon RDS</strong>.
    </p>
  </div>

  <% if (error) { %>
    <div class="p-4 rounded-xl bg-rose-500/10 border border-rose-500/20 text-rose-400 text-sm flex items-center gap-3">
      <i data-lucide="alert-circle" class="w-5 h-5 flex-shrink-0"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Form Card -->
  <div class="rounded-2xl bg-slate-900 border border-slate-800 p-8 shadow-xl">
    <form action="/cars" method="POST" enctype="multipart/form-data" class="space-y-6">

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <!-- Make -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Vehicle Make *
          </label>
          <input type="text" name="make" required placeholder="e.g. Tesla, Audi, Porsche" 
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 text-sm transition-colors">
        </div>

        <!-- Model -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Model *
          </label>
          <input type="text" name="model" required placeholder="e.g. Model Y, RS7, 911 GT3" 
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 text-sm transition-colors">
        </div>

        <!-- Year -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Year *
          </label>
          <input type="number" name="year" required min="2010" max="2026" value="2024" 
                 class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 text-sm transition-colors">
        </div>

        <!-- Category -->
        <div>
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Category *
          </label>
          <select name="category" required 
                  class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white focus:outline-none focus:border-amber-500 text-sm transition-colors">
            <option value="Electric">Electric</option>
            <option value="Sports">Sports</option>
            <option value="SUV">SUV</option>
            <option value="Sedan">Sedan</option>
          </select>
        </div>

        <!-- Daily Rate -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Daily Rental Rate ($ USD) *
          </label>
          <div class="relative">
            <span class="absolute left-4 top-2.5 text-slate-500 text-sm font-bold">$</span>
            <input type="number" name="daily_rate" required min="1" step="0.01" placeholder="120.00" 
                   class="w-full pl-8 pr-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 text-sm transition-colors">
          </div>
        </div>

        <!-- Description -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Vehicle Features & Description
          </label>
          <textarea name="description" rows="3" placeholder="Provide description, mileage limits, horsepower, package specs..." 
                    class="w-full px-4 py-2.5 rounded-xl bg-slate-950 border border-slate-800 text-white placeholder-slate-500 focus:outline-none focus:border-amber-500 text-sm transition-colors"></textarea>
        </div>

        <!-- Image Upload to S3 -->
        <div class="sm:col-span-2">
          <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-2">
            Vehicle Photo (Direct Upload to Amazon S3)
          </label>
          <div class="border-2 border-dashed border-slate-800 rounded-2xl p-6 text-center hover:border-amber-500/50 transition-colors bg-slate-950/50">
            <input type="file" name="image" id="car-image-input" accept="image/*" class="hidden" onchange="previewImage(event)">
            <label for="car-image-input" class="cursor-pointer flex flex-col items-center justify-center space-y-2">
              <div class="w-12 h-12 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center">
                <i data-lucide="image-plus" class="w-6 h-6"></i>
              </div>
              <span class="text-sm font-semibold text-white">Click to select photo</span>
              <span class="text-xs text-slate-500">Supports PNG, JPG, WebP up to 5MB</span>
            </label>
            <div id="image-preview" class="mt-4 hidden">
              <img id="preview-img" src="" alt="Selected Preview" class="max-h-48 mx-auto rounded-xl border border-slate-700">
            </div>
          </div>
        </div>

      </div>

      <!-- Cloud Target Indicators -->
      <div class="p-4 rounded-xl bg-slate-950 border border-slate-800/80 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs">
        <div class="flex items-center gap-2 text-slate-400">
          <i data-lucide="check-circle" class="w-4 h-4 text-sky-400"></i>
          <span>Target Bucket: <strong class="text-slate-200 font-mono"><%= s3Bucket %></strong></span>
        </div>
        <div class="flex items-center gap-2 text-slate-400">
          <i data-lucide="check-circle" class="w-4 h-4 text-emerald-400"></i>
          <span>Target Database: <strong class="text-slate-200 font-mono">Amazon RDS (cars table)</strong></span>
        </div>
      </div>

      <!-- Submit Button -->
      <div class="flex items-center justify-end gap-4 pt-4 border-t border-slate-800">
        <a href="/cars" class="px-5 py-2.5 rounded-xl text-slate-400 hover:text-white text-sm font-semibold transition-colors">
          Cancel
        </a>
        <button type="submit" 
                class="px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 hover:from-amber-400 hover:to-orange-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/25 transition-all inline-flex items-center gap-2">
          <i data-lucide="cloud-upload" class="w-4 h-4"></i>
          <span>Upload & Save Vehicle</span>
        </button>
      </div>

    </form>
  </div>

</div>

<script>
  function previewImage(event) {
    const file = event.target.files[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('preview-img').src = e.target.result;
        document.getElementById('image-preview').classList.remove('hidden');
      };
      reader.readAsDataURL(file);
    }
  }
</script>

<%- include('partials/footer') %>

