        <mxCell id="cUserS" value="─────────────────────&lt;br/&gt;+ signIn(): void&lt;br/&gt;+ signOut(): void&lt;br/&gt;+ updateProfile(): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cUser">
          <mxGeometry x="0" y="140" width="240" height="60" as="geometry" />
