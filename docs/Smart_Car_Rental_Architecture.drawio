        <mxCell id="cRevS" value="─────────────────────&lt;br/&gt;+ submit(): void&lt;br/&gt;+ getAvgRating(): Float" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cRev">
          <mxGeometry x="0" y="130" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- === Notification class === -->
        <mxCell id="cNot" value="&lt;b&gt;Notification&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fffde7;strokeColor=#f9a825;fontColor=#f57f17;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="700" y="380" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cNotA" value="+ id: UUID&lt;br/&gt;+ user_id: UUID&lt;br/&gt;+ type: Enum {booking, reminder, alert}&lt;br/&gt;+ title: String&lt;br/&gt;+ body: String&lt;br/&gt;+ read: Boolean&lt;br/&gt;+ created_at: Timestamp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cNot">
          <mxGeometry x="0" y="30" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cNotS" value="─────────────────────&lt;br/&gt;+ send(): void&lt;br/&gt;+ markRead(): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cNot">
          <mxGeometry x="0" y="130" width="230" height="50" as="geometry" />
        </mxCell>

        <!-- === RateLimiter class === -->
        <mxCell id="cRL" value="&lt;b&gt;RateLimiter&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#880e4f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="100" width="240" height="160" as="geometry" />
