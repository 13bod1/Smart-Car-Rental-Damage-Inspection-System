  <diagram id="page4-cc" name="4. C&amp;C + Deployment">
    <mxGraphModel dx="1422" dy="762" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t" value="Smart Car Rental Platform — Component &amp; Connector + Deployment Diagram" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1a1a2e;" vertex="1" parent="1">
          <mxGeometry x="200" y="20" width="1250" height="40" as="geometry" />
        </mxCell>

        <!-- ==== USER BROWSER ==== -->
        <mxCell id="browser" value="&lt;b&gt;User Browser&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#eceff1;strokeColor=#546e7a;fontColor=#263238;fontStyle=1;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="220" height="160" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="React / Next.js&lt;br/&gt;Client Components&lt;br/&gt;(Pages &amp; UI)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#b0bec5;strokeColor=#546e7a;fontSize=10;" vertex="1" parent="browser">
          <mxGeometry x="20" y="50" width="175" height="80" as="geometry" />
        </mxCell>

        <!-- ==== VERCEL EDGE ==== -->
        <mxCell id="vercelBox" value="&lt;b&gt;Vercel Edge / CDN&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fff9c4;strokeColor=#f9a825;fontColor=#f57f17;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="80" width="380" height="380" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="&lt;b&gt;Next.js App Router&lt;/b&gt;&lt;br/&gt;Server Components&lt;br/&gt;Static Pages (SSG/ISR)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff176;strokeColor=#f9a825;fontSize=11;" vertex="1" parent="vercelBox">
          <mxGeometry x="20" y="50" width="175" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="&lt;b&gt;API Route: Fleet&lt;/b&gt;&lt;br/&gt;/api/vehicles" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff176;strokeColor=#f9a825;fontSize=11;" vertex="1" parent="vercelBox">
          <mxGeometry x="210" y="50" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="&lt;b&gt;API Route: Bookings&lt;/b&gt;&lt;br/&gt;/api/bookings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff176;strokeColor=#f9a825;fontSize=11;" vertex="1" parent="vercelBox">
          <mxGeometry x="20" y="150" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="&lt;b&gt;API Route: AI Damage&lt;/b&gt;&lt;br/&gt;/api/ai/damage&lt;br/&gt;(Groq Vision call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff176;strokeColor=#f9a825;fontSize=11;" vertex="1" parent="vercelBox">
          <mxGeometry x="190" y="150" width="170" height="80" as="geometry" />
        </mxCell>
        <mxCell id="v5" value="&lt;b&gt;Middleware&lt;/b&gt;&lt;br/&gt;Auth Check + Rate Limit&lt;br/&gt;(Upstash Redis)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffeb3b;strokeColor=#f9a825;fontSize=11;fontStyle=1;" vertex="1" parent="vercelBox">
          <mxGeometry x="80" y="260" width="220" height="80" as="geometry" />
        </mxCell>

        <!-- ==== SUPABASE PLATFORM ==== -->
        <mxCell id="supabaseBox" value="&lt;b&gt;Supabase Platform&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#fce4ec;strokeColor=#c2185b;fontColor=#880e4f;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="750" y="80" width="390" height="380" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;Auth Service&lt;/b&gt;&lt;br/&gt;JWT tokens, OAuth,&lt;br/&gt;Email/Password" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="supabaseBox">
          <mxGeometry x="20" y="55" width="165" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;PostgreSQL Database&lt;/b&gt;&lt;br/&gt;Tables: users, vehicles,&lt;br/&gt;bookings, reviews,&lt;br/&gt;damage_reports" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="supabaseBox">
          <mxGeometry x="205" y="55" width="165" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Row Level Security (RLS)&lt;/b&gt;&lt;br/&gt;Owners see own fleet only.&lt;br/&gt;Renters see own bookings." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="supabaseBox">
          <mxGeometry x="20" y="165" width="165" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;Supabase Storage&lt;/b&gt;&lt;br/&gt;Vehicle images,&lt;br/&gt;KYC documents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8bbd0;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="supabaseBox">
          <mxGeometry x="205" y="165" width="165" height="90" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="&lt;b&gt;Realtime Engine&lt;/b&gt;&lt;br/&gt;Booking status push&lt;br/&gt;notifications (WebSocket)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f48fb1;strokeColor=#c2185b;fontSize=11;" vertex="1" parent="supabaseBox">
          <mxGeometry x="80" y="275" width="230" height="80" as="geometry" />
