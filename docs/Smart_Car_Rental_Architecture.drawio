        <mxCell id="cRLA" value="+ windowMs: Integer&lt;br/&gt;+ maxRequests: Integer&lt;br/&gt;+ identifier: String" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cRL">
          <mxGeometry x="0" y="30" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cRLS" value="─────────────────────&lt;br/&gt;+ check(ip): Boolean&lt;br/&gt;+ reset(): void" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cRL">
          <mxGeometry x="0" y="90" width="240" height="70" as="geometry" />
