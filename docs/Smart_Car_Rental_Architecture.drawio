        <!-- === Vehicle class === -->
        <mxCell id="cVeh" value="&lt;b&gt;Vehicle&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e8f5e9;strokeColor=#388e3c;fontColor=#1b5e20;fontStyle=1;fontSize=12;" vertex="1" parent="1">
