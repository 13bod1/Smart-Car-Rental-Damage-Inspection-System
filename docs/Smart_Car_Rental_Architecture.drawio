        <mxCell id="cVehA" value="+ id: UUID&lt;br/&gt;+ owner_id: UUID&lt;br/&gt;+ make: String&lt;br/&gt;+ model: String&lt;br/&gt;+ year: Integer&lt;br/&gt;+ category: String&lt;br/&gt;+ daily_rate: Decimal&lt;br/&gt;+ status: Enum {available, rented, maintenance}&lt;br/&gt;+ image_url: String&lt;br/&gt;+ fuel_type: String" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cVeh">
          <mxGeometry x="0" y="30" width="250" height="130" as="geometry" />
