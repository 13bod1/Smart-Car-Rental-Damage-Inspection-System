        <mxCell id="cBookS" value="─────────────────────&lt;br/&gt;+ confirm(): void&lt;br/&gt;+ cancel(): void&lt;br/&gt;+ calcCost(): Decimal" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cBook">
          <mxGeometry x="0" y="160" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- === DamageReport class === -->
        <mxCell id="cDmg" value="&lt;b&gt;DamageReport&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#f3e5f5;strokeColor=#7b1fa2;fontColor=#4a148c;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="380" width="250" height="210" as="geometry" />
        </mxCell>
        <mxCell id="cDmgA" value="+ id: UUID&lt;br/&gt;+ booking_id: UUID&lt;br/&gt;+ image_url: String&lt;br/&gt;+ damage_detected: Boolean&lt;br/&gt;+ severity: Enum {none, minor, moderate, severe}&lt;br/&gt;+ total_repair_cost_egp: Decimal&lt;br/&gt;+ damage_zones: JSON[]&lt;br/&gt;+ created_at: Timestamp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cDmg">
          <mxGeometry x="0" y="30" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="cDmgS" value="─────────────────────&lt;br/&gt;+ analyze(image): DamageReport&lt;br/&gt;+ getDeposit(): String" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cDmg">
          <mxGeometry x="0" y="150" width="250" height="60" as="geometry" />
        </mxCell>

        <!-- === Review class === -->
        <mxCell id="cRev" value="&lt;b&gt;Review&lt;/b&gt;" style="swimlane;startSize=30;fillColor=#e0f2f1;strokeColor=#00695c;fontColor=#004d40;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="230" height="180" as="geometry" />
        </mxCell>
        <mxCell id="cRevA" value="+ id: UUID&lt;br/&gt;+ booking_id: UUID&lt;br/&gt;+ reviewer_id: UUID&lt;br/&gt;+ vehicle_id: UUID&lt;br/&gt;+ rating: Integer (1-5)&lt;br/&gt;+ comment: String&lt;br/&gt;+ created_at: Timestamp" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacingLeft=8;fontSize=10;" vertex="1" parent="cRev">
          <mxGeometry x="0" y="30" width="230" height="100" as="geometry" />
